#include <WiFi.h>
#include <WebServer.h>
#include <SPI.h>
#include <RF24.h>

const char* ssid = "Somya";
const char* password = "42785496";

WebServer server(80);
RF24 radio(4, 5);

const byte addressTX[6] = "TX001";
const byte addressRX[6] = "RX001";

String chatHistory = "";
bool radioReady = false;

void handleRoot() {
  String page = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ESP32 Chat</title>
<style>
body { font-family: Arial; margin: 20px; }
#chat { height: 300px; overflow-y: auto; border: 1px solid #aaa; padding: 10px; margin-bottom: 10px; }
input { width: 65%; padding: 10px; }
button { padding: 10px; }
</style>
</head>
<body>
<h2>Phone 2 - ESP32 Chat</h2>
<div id="chat"></div>
<input id="msg" maxlength="31" placeholder="Type message">
<button onclick="sendMsg()">Send</button>
<p id="status"></p>
<script>
async function refreshChat() {
  let r = await fetch('/messages');
  document.getElementById('chat').innerHTML = await r.text();
}
async function sendMsg() {
  let box = document.getElementById('msg');
  let m = box.value.trim();
  if (!m) return;
  let r = await fetch('/send?msg=' + encodeURIComponent(m));
  document.getElementById('status').innerText = await r.text();
  box.value = '';
  refreshChat();
}
setInterval(refreshChat, 1000);
refreshChat();
</script>
</body>
</html>
)rawliteral";

  server.send(200, "text/html", page);
}

void handleSend() {
  String msg = server.arg("msg");
  msg.trim();

  if (msg.length() == 0) {
    server.send(400, "text/plain", "Enter a message");
    return;
  }

  if (!radioReady) {
    server.send(500, "text/plain", "Radio not detected. Check wiring.");
    return;
  }

  char payload[32] = {0};
  msg.substring(0, 31).toCharArray(payload, sizeof(payload));

  radio.stopListening();
  radio.openWritingPipe(addressTX);
  bool sent = radio.write(payload, sizeof(payload));
  radio.startListening();

  if (sent) {
    chatHistory += "<p><b>You:</b> " + msg + "</p>";
    server.send(200, "text/plain", "Message sent to TX");
    Serial.print("Sent to TX: ");
    Serial.println(msg);
  } else {
    server.send(200, "text/plain", "Send failed. Check TX radio.");
    Serial.println("Radio transmission failed");
  }
}

void handleMessages() {
  server.send(200, "text/html", chatHistory);
}

void setup() {
  Serial.begin(115200);
  SPI.begin(18, 19, 23, 5);

  radioReady = radio.begin();

  if (radioReady) {
    radio.setChannel(76);
    radio.setDataRate(RF24_250KBPS);
    radio.setPALevel(RF24_PA_LOW);
    radio.setAutoAck(true);
    radio.openReadingPipe(1, addressRX);
    radio.startListening();
    Serial.println("Radio Ready");
  } else {
    Serial.println("Radio not detected! Check wiring and 3.3V power.");
  }

  WiFi.mode(WIFI_AP);
  bool apStarted = WiFi.softAP(ssid, password);

  if (apStarted) {
    Serial.println("RX Wi-Fi Started");
    Serial.print("Wi-Fi Name: ");
    Serial.println(ssid);
    Serial.print("IP Address: ");
    Serial.println(WiFi.softAPIP());
  } else {
    Serial.println("Wi-Fi hotspot failed");
  }

  server.on("/", handleRoot);
  server.on("/send", handleSend);
  server.on("/messages", handleMessages);
  server.begin();

  Serial.println("RX Chat Server Ready");
}

void loop() {
  server.handleClient();

  if (radioReady && radio.available()) {
    char payload[32] = {0};
    radio.read(payload, sizeof(payload));

    if (payload[0] != '\0') {
      Serial.print("Received from TX: ");
      Serial.println(payload);

      chatHistory += "<p><b>Phone 1:</b> ";
      chatHistory += payload;
      chatHistory += "</p>";
    }
  }
}
